rules_version = '2';

// Ảnh buổi tập. Path có tiền tố uid để diễn đạt được quyền sở hữu.
service firebase.storage {
  match /b/{bucket}/o {
    function domainOk() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.matches('.*@apollo[.]edu[.]vn$');
    }
    // Admin (kiểm duyệt) — tra collection admins/{uid} ở Firestore.
    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /sessions/{uid}/{file} {
      allow read:  if domainOk();
      allow write: if domainOk()
                   && uid == request.auth.uid
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
      // Chủ ảnh xoá được; admin gỡ ảnh bài vi phạm.
      allow delete: if domainOk() && (uid == request.auth.uid || isAdmin());
    }

    // Ảnh đính kèm THÔNG BÁO (announcement) của CLB / mục tiêu công ty (F6).
    // Path tiền tố uid diễn đạt quyền sở hữu; file đặt theo id doc thông báo.
    match /announcements/{uid}/{file} {
      allow read:  if domainOk();
      allow write: if domainOk()
                   && uid == request.auth.uid
                   && request.resource.size < 3 * 1024 * 1024
                   && request.resource.contentType == 'image/jpeg';
      allow delete: if domainOk() && (uid == request.auth.uid || isAdmin());
    }

    match /{allPaths=**} { allow read, write: if false; }
  }
}
